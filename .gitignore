# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python

# Build and packaging artifacts
build/
dist/
sdist/
wheels/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Environments
# ---------------------------------------------------------------------------
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Agent/editor scratch settings are developer-local.
.claude/

# ---------------------------------------------------------------------------
# Testing, coverage and linting caches
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# Figures produced by the test suite are regenerated on every run.
tests/figures/

# ---------------------------------------------------------------------------
# Local-only working directories
# ---------------------------------------------------------------------------
# Generated MkDocs output; the Markdown sources under documentation/ are tracked.
/site/
# Trained weights and ad-hoc prediction dumps are far too large to version.
models/
saved_predictions/

# ---------------------------------------------------------------------------
# Generated figures
# ---------------------------------------------------------------------------
# Figure exports are local byproducts and never belong in the repository.
*.png
*.pdf
*.svg

# ---------------------------------------------------------------------------
# Data and raw model output
# ---------------------------------------------------------------------------
# No dataset belongs in this package repository. Common data directories are
# ignored globally as a second line of defence against accidental commits.
**/data/
**/dataset/
**/datasets/
**/downloads/
**/raw/
