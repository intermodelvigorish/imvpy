# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python

# Build and packaging artifacts
build/
dist/
sdist/
wheels/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Environments
# ---------------------------------------------------------------------------
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Agent/editor scratch settings are developer-local.
.claude/

# ---------------------------------------------------------------------------
# Testing, coverage and linting caches
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# Figures produced by the test suite are regenerated on every run.
tests/figures/

# ---------------------------------------------------------------------------
# Local-only working directories
# ---------------------------------------------------------------------------
# Superseded pre-reorganisation material, kept on disk for reference only.
/archive/
# Internal methodology, API, audit and parity write-ups are maintained offline and
# deliberately not published with the package.
/documentation/
# Reserved for a future generated documentation site.
/docs/
# Trained weights and ad-hoc prediction dumps are far too large to version.
models/
saved_predictions/

# ---------------------------------------------------------------------------
# Generated figures
# ---------------------------------------------------------------------------
# Figures are byproducts everywhere except examples/**/figures, which holds the
# curated, executed-notebook output that serves as reproduction evidence.
*.png
*.pdf
!examples/**/figures/*.png
!examples/**/figures/*.pdf

# ---------------------------------------------------------------------------
# Example data and raw model output
# ---------------------------------------------------------------------------
# No dataset belongs in this repository. Every example downloads what it needs
# into a cache outside the working tree, so a cold clone can run them all.
# Aggregated result tables under examples/**/results/ are kept as evidence; raw
# per-run predictions are regenerated by the notebook and are not.
examples/**/results/*.pkl
examples/ablation_imv/results/predictions_*.csv
examples/**/data/
